<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for WKWebView JavaScript JIT under hardened runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Microphone access for speech-to-text recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- AppleScript access for browser URL detection (context_detect.rs) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Do NOT add keychain-access-groups (or any other restricted entitlement)
         here unless an embedded.provisionprofile that authorises it is bundled.
         Without one, macOS refuses to launch the Developer ID-signed app
         ("Unsatisfied entitlements" → "Sumi can't be opened", issue #39).
         credentials.rs falls back to the login keychain via the security CLI
         when the Data Protection Keychain entitlement is absent. -->
</dict>
</plist>
